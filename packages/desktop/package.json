{
	"name": "@earendil-works/pi-orbit",
	"version": "0.1.0-rc.2",
	"private": true,
	"type": "module",
	"main": "dist/main.js",
	"scripts": {
		"build:main": "node scripts/prepare-node-pty.mjs && tsc -p tsconfig.build.json && node --experimental-strip-types scripts/build-preload.mjs",
		"build:renderer": "vite build --config renderer/vite.config.ts",
		"build": "npm run build:main && npm run build:renderer",
		"dev": "vite --config renderer/vite.config.ts",
		"typecheck:renderer": "tsc --noEmit -p renderer/tsconfig.json",
		"test": "npm run test:vitest && npm run test:node",
		"test:vitest": "node ../../node_modules/vitest/dist/cli.js --configLoader runner --run",
		"test:node": "node --test test/extensions/desktop-ui-context.test.ts test/git/worktrees.test.ts test/main/app-service.test.ts test/main/codex-adaptations.test.ts test/main/session-message.test.ts test/main/worker-ui-dismiss.test.ts",
		"package:win": "electron-builder --win nsis --config.npmRebuild=false",
		"package:mac": "node scripts/prepare-node-pty.mjs && electron-builder --mac dmg --config.npmRebuild=false",
		"package:linux": "electron-builder --linux AppImage --config.npmRebuild=false"
	},
	"dependencies": {
		"@earendil-works/chord": "1.0.2",
		"@earendil-works/pi-agent-core": "1.0.2",
		"@earendil-works/pi-ai": "1.0.2",
		"@earendil-works/pi-coding-agent": "1.0.2",
		"@earendil-works/pi-durable": "1.0.2",
		"@earendil-works/pi-tui": "1.0.2",
		"@xterm/addon-fit": "0.11.0",
		"@xterm/xterm": "6.0.0",
		"node-pty": "1.1.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"typebox": "1.3.27",
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"electron": "44.4.5",
		"electron-builder": "26.15.3",
		"esbuild": "0.28.2",
		"vite": "8.3.0",
		"vitest": "4.1.11"
	},
	"build": {
		"appId": "works.earendil.pi.orbit",
		"productName": "Pi Orbit",
		"directories": {
			"output": "release"
		},
		"files": [
			"dist/**/*",
			"package.json"
		],
		"asarUnpack": [
			"**/node-pty/build/Release/**/*",
			"**/node-pty/prebuilds/**/*"
		],
		"win": {
			"target": "nsis"
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true
		},
		"mac": {
			"target": "dmg",
			"hardenedRuntime": true
		},
		"linux": {
			"target": "AppImage",
			"executableName": "pi-orbit"
		}
	}
}
